<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <!-- Module Category -->
    <record id="module_category_equipment_loan" model="ir.module.category">
        <field name="name">Equipment Loan</field>
        <field name="description">Equipment Loan Tracker</field>
        <field name="sequence">10</field>
    </record>

    <!-- Module Privilege -->
    <record id="group_privilege_equipment_loan" model="res.groups.privilege">
        <field name="name">Equipment Loan</field>
        <field name="description">Equipment Loan Tracker</field>
        <field name="category_id" ref="equipment_loan_tracker.module_category_equipment_loan" />
        <field name="sequence">10</field>
    </record>

    <!-- User Group -->
    <record id="group_equipment_user" model="res.groups">
        <field name="name">Equipment User</field>
        <field name="privilege_id" ref="equipment_loan_tracker.group_privilege_equipment_loan" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        <field name="user_ids" eval="[(4, ref('base.user_demo'))]" />
    </record>

    <!-- Manager Group -->
    <record id="group_equipment_manager" model="res.groups">
        <field name="name">Equipment Manager</field>
        <field name="privilege_id" ref="equipment_loan_tracker.group_privilege_equipment_loan" />
        <field name="implied_ids" eval="[(4, ref('equipment_loan_tracker.group_equipment_user'))]" />
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]" />
    </record>
</odoo>