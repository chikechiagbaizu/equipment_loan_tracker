<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <!-- User -->
    <record id="rule_equipment_loan_user" model="ir.rule">
        <field name="name">Equipment Loan: User Access</field>
        <field name="model_id" ref="model_equipment_loan" />
        <field name="domain_force">[('employee_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('equipment_loan_tracker.group_equipment_user'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="False" />
    </record>

    <!-- Manager -->
    <record id="rule_equipment_loan_manager" model="ir.rule">
        <field name="name">Equipment Loan: Manager Access</field>
        <field name="model_id" ref="model_equipment_loan" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('equipment_loan_tracker.group_equipment_manager'))]" />
    </record>
</odoo>