<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <data>
        <record id="equipment_item_form_view" model="ir.ui.view">
            <field name="name">equipment.item.form.view</field>
            <field name="model">equipment.item</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="category" />
                            <field name="daily_rate" help="Cost per day if not returned on time" />
                            <field name="active" />
                        </group>
                        <notebook>
                            <page string="Loans">
                                <field name="loan_ids">
                                    <list>
                                        <field name="employee_id" />
                                        <field name="equipment_id" />
                                        <field name="loan_date" />
                                        <field name="state" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>