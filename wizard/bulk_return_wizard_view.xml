<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <data>
        <record id="bulk_return_wizard_form_view" model="ir.ui.view">
            <field name="name">bulk.return.wizard.form.view</field>
            <field name="model">bulk.return.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="return_date" />
                    </group>
                    <footer>
                        <button name="action_bulk_return" string="Confirm Return" type="object"
                            class="btn-primary" />
                        <button string="Cancel" type="object" class="btn-secondary" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_bulk_return_wizard" model="ir.actions.act_window">
            <field name="name">Bulk Return</field>
            <field name="res_model">bulk.return.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="model_equipment_loan" />
            <field name="binding_view_types">list</field>
        </record>
    </data>
</odoo>